# Copy to .env (git-ignored) and change these anywhere other than a laptop.
# Docker Compose reads .env automatically.

# Signing key for player tokens, 32+ bytes. Empty: a random key per start (tokens die on restart).
AUTH_TOKEN_SECRET=

# Elasticsearch superuser (only the setup container uses it) and the app's own user.
ELASTIC_PASSWORD=elastic-local-only
ES_APP_PASSWORD=app-local-only

# Set to 24h to play or load test after 20:00 UTC.
TOURNAMENT_CLOSES_AT=20h
